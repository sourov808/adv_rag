[project]
name = "interview-rag"
version = "0.1.0"
description = "An explainable, interview-ready retrieval-augmented generation project"
readme = "README.md"
requires-python = ">=3.12,<3.13"
dependencies = [
    "chromadb>=1.5,<2",
    "groq>=1.7,<2",
    "pydantic>=2.12,<3",
    "pydantic-settings>=2.15,<3",
    "pypdf>=6,<7",
    "sentence-transformers>=6,<7",
    "streamlit>=1.40,<2",
]

[project.optional-dependencies]
dev = ["pytest>=8,<10", "ruff>=0.9,<1"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]

[tool.ruff]
line-length = 100
target-version = "py311"

